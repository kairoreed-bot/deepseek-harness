# Linux packaging template. Copy to .env.linux (git ignored); CI does the copy itself.
# No signing configuration exists for the linux target: AppImage/deb/rpm are unsigned by design.

DSH_DESKTOP_APP_ID=com.deepseek.dsh
# Selects which mandatory-update origin a signed release would embed. Unsigned linux builds skip that policy.
DSH_DESKTOP_AUTO_UPDATE_ENV=test

# electron-builder pack workers and compression level (0-9). AppImage is squashfs, so 9 is worth it.
DSH_DESKTOP_LINUX_PACK_CONCURRENCY=4
DSH_DESKTOP_LINUX_COMPRESSION_LEVEL=9

# Optional npm registry for the bundled dsh runtime install; defaults to https://registry.npmjs.org/.
# DSH_DESKTOP_NPM_REGISTRY=https://registry.npmmirror.com
